pipeline {
    agent any
    environment {
        IMAGE_NAME = 'achat-app'
        IMAGE_TAG  = "${BUILD_NUMBER}"
        MVN = '/var/jenkins_home/tools/hudson.tasks.Maven_MavenInstallation/Maven3/bin/mvn'
        NEXUS_URL = 'http://172.17.0.1:8081'
        NEXUS_REPO = 'maven-releases'
        DC_HOME = '/var/jenkins_home/tools/org.jenkinsci.plugins.DependencyCheck.tools.DependencyCheckInstallation/OWASP-DC'
        NVD_API_KEY = 'b4fb1df4-5897-4cdc-b243-979ce2f487d1'
    }
    stages {

        stage('Checkout') {
            steps {
                echo '📥 Récupération du code...'
                checkout scm
            }
        }

        stage('Docker Permission') {
            steps {
                sh 'chmod 666 /var/run/docker.sock || true'
            }
        }

        stage('Build') {
            steps {
                echo '🔨 Build Maven...'
                dir('achat/achat') {
                    sh '${MVN} clean package -DskipTests -B'
                }
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Tests unitaires...'
                dir('achat/achat') {
                    sh '${MVN} test -B'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '🔍 Analyse SonarQube...'
                dir('achat/achat') {
                    withSonarQubeEnv('Sonar') {
                        sh '${MVN} sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '🚦 Vérification Quality Gate...'
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    timeout(time: 1, unit: 'MINUTES') {
                        waitForQualityGate abortPipeline: false
                    }
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                echo '🔒 Scan OWASP des dépendances...'
                dir('achat/achat') {
                    sh '''
                        ${DC_HOME}/bin/dependency-check.sh \
                            --scan ./ \
                            --format HTML \
                            --format XML \
                            --out dependency-check-report \
                            --project achat \
                            --nvdApiKey ${NVD_API_KEY} \
			    --disableOssIndex || true
                    '''
                }
            }
            post {
                always {
                    dependencyCheckPublisher(
                        pattern: 'achat/achat/dependency-check-report/dependency-check-report.xml',
                        failedTotalCritical: 0,
                        unstableTotalHigh: 10
                    )
                }
            }
        }

        stage('Nexus Deploy') {
            steps {
                echo '📦 Publication vers Nexus...'
                dir('achat/achat') {
                    sh '''
                        ${MVN} deploy -DskipTests -B \
                        -s /var/jenkins_home/.m2/settings.xml \
                        -DaltDeploymentRepository=nexus-releases::default::${NEXUS_URL}/repository/${NEXUS_REPO}
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo '🐳 Construction image Docker...'
                dir('achat/achat') {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                    sh 'docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest'
                }
            }
        }

        stage('Trivy Scan - Filesystem') {
            steps {
                echo '🔒 Scan Trivy des dépendances Maven...'
                dir('achat/achat') {
                    sh '''
                        trivy fs \
                            --scanners vuln \
                            --severity HIGH,CRITICAL \
                            --format table \
                            --exit-code 0 \
                            ./pom.xml || true
                    '''
                }
            }
        }

        stage('Trivy Scan - Image') {
            steps {
                echo '🔒 Scan Trivy image Docker...'
                sh '''
                    trivy image \
                        --scanners vuln \
                        --vuln-type os \
                        --skip-java-db-update \
                        --severity HIGH,CRITICAL \
                        --format table \
                        --exit-code 0 \
                        --timeout 5m \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }


        stage('Docker Deploy') {
            steps {
                echo '🚀 Déploiement avec Docker Compose...'
                dir('achat/achat') {
                    sh 'docker-compose up -d --no-deps --build app'
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline terminé avec succès !'
        }
        failure {
            echo '❌ Pipeline échoué !'
        }
        always {
            echo '🏁 Pipeline finished'
        }
    }
}
